{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "date": {
      "type": "date"
    },
    "time": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "price": {
      "type": "decimal"
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "organizer": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "eventStatus": {
      "type": "enumeration",
      "default": "Upcoming",
      "enum": [
        "Upcoming",
        "Ongoing",
        "Completed"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category"
    }
  }
}
