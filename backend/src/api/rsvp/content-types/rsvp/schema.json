{
  "kind": "collectionType",
  "collectionName": "rsvps",
  "info": {
    "singularName": "rsvp",
    "pluralName": "rsvps",
    "displayName": "RSVP"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "rsvpStatus": {
      "type": "enumeration",
      "default": "Pending",
      "enum": [
        "Pending",
        "Confirmed",
        "Cancelled"
      ]
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event"
    },
    "userName": {
      "type": "string"
    }
  }
}
